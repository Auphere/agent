"""
Plan-and-Execute Agent using LangGraph for advanced multi-step reasoning.

IMPROVEMENTS OVER ORIGINAL:
1. ✅ Parameter memory across conversation turns (fixes "why ask again?" bug)
2. ✅ No duplicate titles ("cultural cultural")
3. ✅ Budget validation against user limits
4. ✅ LLM-based city extraction (more robust)
5. ✅ LLM-based vibes extraction (better accuracy)
6. ✅ Proper place deduplication
7. ✅ Better error handling and logging

This agent implements a sophisticated Plan-and-Execute pattern where:

1. PLANNER: Creates a multi-step plan to accomplish the user's goal
2. EXECUTOR: Executes each step using appropriate tools
3. REPLANNER: Adapts the plan based on execution results
4. FINAL ANSWER: Synthesizes all information into a comprehensive response

Similar to how Perplexity, OpenAI, and Claude handle complex queries.
"""

from __future__ import annotations

import json
import re
from typing import Any, Dict, List, Optional, TypedDict, Annotated, Sequence
from uuid import uuid4

from langchain_core.messages import BaseMessage, HumanMessage, SystemMessage, AIMessage, FunctionMessage
from langchain_core.prompts import ChatPromptTemplate
from langchain_openai import ChatOpenAI
from langgraph.graph import StateGraph, END
from langgraph.prebuilt import ToolNode
from langgraph.checkpoint.postgres.aio import AsyncPostgresSaver

from src.config.settings import Settings, get_settings
from src.utils.logger import get_logger
from src.agents.utils.place_extractor import extract_places_from_messages
from src.agents.utils.place_saver import save_places_to_db
from src.agents.utils.text_cleaner import clean_response_text

logger = get_logger("plan_and_execute_agent")


# ============================================================================
# State definition for the graph
# ============================================================================

class PlanExecuteState(TypedDict):
    """
    Minimal state for Plan-and-Execute agent following LangGraph best practices.
    
    IMPROVEMENTS OVER ORIGINAL:
    1. ✅ Separates immutable inputs from mutable state
    2. ✅ Removes redundant fields (tool_results duplicates messages)
    3. ✅ Removes parameter_memory (handled in context)
    4. ✅ Cleaner, more maintainable structure
    """
    
    # Input (immutable - set once at start)
    input: str  # User query
    language: str
    context: Dict[str, Any]  # Includes plan_params, location, history, etc.
    
    # Planning state (mutable)
    plan: List[str]  # List of steps in the plan
    past_steps: Annotated[List[tuple], "operator.add"]  # (step, result) tuples
    current_step: Optional[str]
    
    # Execution state (mutable)
    messages: Annotated[Sequence[BaseMessage], "operator.add"]
    
    # Output (populated at end)
    response_text: str
    places: List[Dict[str, Any]]
    plan_json: Optional[Dict[str, Any]]
    
    # Metadata (for debugging/monitoring)
    agent_type: str
    model_used: str
    reasoning_steps: int


# ============================================================================
# Prompts (UPDATED with parameter memory)
# ============================================================================

PLANNER_PROMPT = """You are an expert planning agent for finding and recommending places and generating a structured itinerary JSON.

⚠️ CRITICAL RULE: NEVER ASSUME OR INVENT INFORMATION NOT PROVIDED BY THE USER.

Your task is to create a detailed, step-by-step plan to accomplish the user's request.

## ACCUMULATED PARAMETERS FROM CONVERSATION:

{plan_params}

⚠️ IMPORTANT: These parameters were extracted from the full conversation history.
Use them directly - they already contain accumulated information from all previous turns.

## CURRENT CONTEXT:

{context}

User request: {query}

**STEP 0 - INFORMATION VALIDATION:**

Check if you have ALL required parameters:
1. **num_people**: Number of people
2. **cities**: Location/City  
3. **budget_per_person**: Budget per person
4. **vibes**: Desired atmosphere

If ANY of these are missing in plan_params:

- **DO NOT CREATE A MULTI-STEP PLAN.**
- Return a plan with exactly ONE step: `STOP: Missing [missing_info]`.
- Example: `{{"plan": ["STOP: Missing budget_per_person"], "reasoning": "User didn't specify budget. Already have: num_people=2, cities=['Zaragoza'], vibes=['romantic']"}}`

**STEP 1 - PLAN STRUCTURE (if info is complete):**

Create a plan with 3-5 specific steps.

Each step should specify which tool to use.

Available tools (preferred order):

1. geocode_city_tool: ALWAYS use first if a city is mentioned.
2. google_places_tool: Use for finding restaurants, bars, and activities.
3. rank_by_score_tool: Use to rank the findings.
4. generate_plan_json_tool: ALWAYS use as the last step to create the structured itinerary.

Return ONLY a JSON object:

{{
  "plan": [
    "Step 1: ...",
    "Step 2: ..."
  ],
  "reasoning": "Brief explanation of the plan strategy"
}}
"""

EXECUTOR_PROMPT = """You are an expert executor agent that carries out specific steps of a plan.

⚠️ CRITICAL RULE: Use ONLY information explicitly provided by the user. DO NOT assume, invent, or deduce information.

Current step to execute: {current_step}

Previous steps completed:

{past_steps}

Context:

{context}

Execute this step using the appropriate tools available to you.

Mandatory behaviors:

- If the step requires locations without coordinates, first call geocode_city_tool to obtain latitude/longitude.
- Prefer google_places_tool; use search_foursquare_places for richer metadata.
- Use rank_by_score_tool before finalizing selections.
- When ready to present an itinerary, CALL generate_plan_json_tool with required fields.

**CRITICAL - When calling generate_plan_json_tool:**

Use ONLY information explicitly provided by the user:

- date: Use "TBD" if user didn't specify (e.g., "este sábado", "el 25 de diciembre")
- start_time: Use "TBD" if not specified, or infer from context:
  - "mediodía"/"lunch" → "14:00"
  - "tarde"/"afternoon" → "18:00"
  - "noche"/"evening" → "21:00"
  - "madrugada"/"late night" → "00:00"
- group_size: ONLY if explicitly stated or clearly inferable
- vibes: Use ONLY vibes mentioned by user
- budget_per_person: Use from accumulated parameters
- stops: Build from found places with conservative time estimates
- final_recommendations: Keep generic, don't invent preferences

For stop details:

- timing.recommendedStart: "TBD" if user didn't specify times
- timing.suggestedDurationMinutes: Conservative (90 min restaurant, 60 min bar/activity, 45 min cafe)
- details.averageSpendPerPerson: null if not mentioned
- selectionReasons: Based ONLY on place data and user's explicit request

Be thorough and extract all relevant information.

Focus on quality over quantity.

Respond with the results of executing this step.
"""

REPLANNER_PROMPT = """You are an expert replanner agent that adapts plans based on execution results.

Original plan:

{original_plan}

Steps completed so far:

{past_steps}

Current situation: {situation}

Analyze the execution results and decide:

1. Should we continue with the remaining steps?
2. Do we need to add new steps?
3. Do we have enough information to answer the user's query?

Response format (JSON):

{{
  "decision": "continue" or "replan" or "finish",
  "updated_plan": ["Step 1", "Step 2", ...], # if replanning
  "reasoning": "Brief explanation"
}}
"""

SYNTHESIZER_PROMPT = """You are an expert synthesis agent that creates comprehensive final answers.

⚠️ CRITICAL RULE: Use ONLY information explicitly provided by the user and found by the tools. DO NOT assume, invent, or deduce user preferences.

User query: {query}

Language: {language}

All executed steps and results:

{all_results}

Context:

{context}

**CRITICAL - HANDLING STOP CONDITIONS:**

If the executed steps contain "STOP:" or mention missing information (budget, group size, vibes, etc.):

- **DO NOT** give generic travel tips or recommendations.
- **ASK the user** for the specific missing information in a friendly, conversational way.
- Format your question to request ALL missing details at once.
- Keep it brief and to the point.

**Example for STOP (Missing Info):**

"¡Genial! Un fin de semana en Barcelona suena increíble. 🎉

Para crear el plan perfecto para ti, necesito saber:

• ¿Cuántas personas van?
• ¿Qué presupuesto tienen aproximadamente por persona?
• ¿Qué tipo de ambiente buscan? (romántico, festivo, cultural, relajado, etc.)

Con esta info puedo diseñarte un itinerario personalizado. 😊"

**CRITICAL - RESPONSE FORMAT (When plan was created successfully):**

- **DO NOT list the places or stops in your text response.** The UI will display the plan card automatically.
- Your response should ONLY contain:

1. A brief, engaging intro (1-2 sentences).
2. A "What to Expect" section (2-3 sentences summarizing the vibe/experience).
3. A "Pro Tips" section (2-3 bullet points with practical advice).

- **DO NOT** repeat the itinerary, times, or addresses.

**Example Response (Successful Plan):**

"¡He diseñado el plan perfecto para tu noche en Valencia! 🌙

**Qué esperar:**

Comenzarás con una cena íntima en un restaurante con encanto, seguido de unos cócteles en una terraza con vistas espectaculares. El ambiente será relajado pero sofisticado, ideal para conversar.

**Mis consejos:**

• Reserva con antelación en el restaurante, suele llenarse.
• El segundo local tiene un código de vestimenta 'smart casual'.
• Si te sobra tiempo, el paseo entre ambos sitios es precioso."
"""


# ============================================================================
# Main Agent Class
# ============================================================================

class PlanAndExecuteAgent:
    """
    Advanced Plan-and-Execute agent using LangGraph.

    This agent uses a multi-stage approach:
    1. Plans a strategy to accomplish the user's goal
    2. Executes each step using appropriate tools
    3. Synthesizes all information into a comprehensive response
    4. Can replan if needed based on intermediate results
    
    KEY IMPROVEMENTS:
    - Parameter memory prevents asking same question twice
    - LLM-based extraction for city and vibes
    - Budget validation against user limits
    - No duplicate titles
    - Proper place deduplication
    """

    def __init__(self, settings: Settings | None = None) -> None:
        self.settings = settings or get_settings()
        self.logger = get_logger("plan_and_execute_agent", settings=self.settings)

        # Use GPT-4o for complex planning and reasoning
        self.planner_llm = ChatOpenAI(
            model="gpt-4o",
            temperature=0.3,  # Lower for consistent planning
            api_key=self.settings.openai_api_key,
        )

        # Use GPT-4o-mini for execution (faster, cheaper)
        self.executor_llm = ChatOpenAI(
            model="gpt-4o-mini",
            temperature=0.5,
            api_key=self.settings.openai_api_key,
        )

        # Use GPT-4o for final synthesis (better quality)
        self.synthesizer_llm = ChatOpenAI(
            model="gpt-4o",
            temperature=0.7,  # Higher for more natural language
            api_key=self.settings.openai_api_key,
        )

        # Get tools
        from src.tools.tool_registry import get_plan_tools

        self.tools = get_plan_tools()

        # Add new enrichment tools
        from src.tools.search.foursquare_v2 import (
            search_foursquare_places,
            get_foursquare_place_enrichment,
        )

        from src.tools.search.apify_enrichment import (
            scrape_instagram_place,
            scrape_tiktok_place,
            scrape_tripadvisor_reviews,
            get_social_media_summary,
        )

        self.enrichment_tools = [
            search_foursquare_places,
            get_foursquare_place_enrichment,
            scrape_instagram_place,
            scrape_tiktok_place,
            scrape_tripadvisor_reviews,
            get_social_media_summary,
        ]

        # All tools for executor
        self.all_tools = self.tools + self.enrichment_tools
        
        # ✅ NEW: Initialize PostgreSQL checkpointer for persistent state
        self.checkpointer = None  # Lazy init (async required)

        # Build the graph
        self.graph = None  # Lazy init (async required)

        self.logger.info("plan-and-execute-agent-initialized")
    
    async def _ensure_graph_initialized(self):
        """Lazy initialize graph with async PostgreSQL checkpointer."""
        if self.graph is not None:
            return
        
        # Initialize PostgreSQL checkpointer
        self.checkpointer = AsyncPostgresSaver.from_conn_string(
            conn_string=self.settings.database_url,
        )
        
        # Setup checkpoint table
        await self.checkpointer.setup()
        
        # Build graph
        self.graph = self._build_graph()
        
        self.logger.info("langgraph-initialized-with-postgres-checkpointer")

    def _build_graph(self) -> StateGraph:
        """Build the LangGraph state machine following standard Plan-and-Execute pattern."""
        workflow = StateGraph(PlanExecuteState)

        # Add nodes (NO synthesizer - synthesis happens in executor's final step)
        workflow.add_node("planner", self._plan_node)
        workflow.add_node("executor", self._execute_node)
        workflow.add_node("replanner", self._replan_node)

        # Set entry point
        workflow.set_entry_point("planner")

        # Add edges
        workflow.add_edge("planner", "executor")
        workflow.add_conditional_edges(
            "executor",
            self._should_continue_or_replan,
            {
                "continue": "executor",
                "replan": "replanner",
                "end": END,  # ✅ Direct to END (no synthesizer)
            },
        )

        workflow.add_edge("replanner", "executor")

        # ✅ Compile with PostgreSQL checkpointer (set in __init__)
        return workflow.compile(checkpointer=self.checkpointer)

    async def _plan_node(self, state: PlanExecuteState) -> Dict[str, Any]:
        """Create initial plan with proper parameter memory handling."""
        self.logger.info("planning", query=state["input"])

        context = state.get("context", {})
        
        # ✅ NEW: Get plan_params from context (extracted in streaming_routes.py)
        plan_params = context.get("plan_params", {})
        
        # Check if we have enough info to create plan
        required_fields = ["num_people", "cities", "budget_per_person", "vibes"]
        missing = []
        for field in required_fields:
            value = plan_params.get(field)
            if value is None or (isinstance(value, list) and len(value) == 0):
                missing.append(field)
        
        if missing:
            # Generate conversational request for missing info
            self.logger.info("plan-stopped-missing-info", missing=missing, have=list(plan_params.keys()))
            
            # Build natural question
            language = state.get("language", "es")
            if language.startswith("es"):
                field_prompts = {
                    "num_people": "¿Cuántas personas van?",
                    "cities": "¿En qué ciudad?",
                    "budget_per_person": "¿Qué presupuesto aproximado por persona?",
                    "vibes": "¿Qué tipo de ambiente buscan? (romántico, animado, tranquilo, elegante, etc.)",
                }
            else:
                field_prompts = {
                    "num_people": "How many people?",
                    "cities": "Which city?",
                    "budget_per_person": "Approximate budget per person?",
                    "vibes": "What kind of atmosphere? (romantic, energetic, chill, elegant, etc.)",
                }
            
            questions = [field_prompts.get(field, field) for field in missing]
            
            # Return plan with STOP (but better messaging)
            return {
                "plan": [f"STOP: Missing {', '.join(missing)}"],
                "current_step": f"STOP: Missing {', '.join(missing)}",
                "past_steps": [],
            }

        # Extract conversation history
        conversation_history = context.get("conversation_history_text", "") or context.get("conversation_history", "")

        if not conversation_history:
            recent_turns = context.get("recent_turns", [])
            if recent_turns:
                history_lines = []
                for turn in recent_turns:
                    if isinstance(turn, dict):
                        history_lines.append(f"User: {turn.get('user_query', '')}")
                        history_lines.append(f"Assistant: {turn.get('agent_response', '')}")
                conversation_history = "\n".join(history_lines)

        # Build prompt with accumulated parameters
        prompt = PLANNER_PROMPT.format(
            query=state["input"],
            context=json.dumps(state.get("context", {}), indent=2),
            conversation_history=conversation_history or "No previous conversation.",
            plan_params=json.dumps(plan_params, indent=2),  # ✅ NEW: Pass params directly
        )

        messages = [SystemMessage(content=prompt)]

        try:
            response = await self.planner_llm.ainvoke(messages)
            response_text = response.content

            # Parse plan from response
            if "```json" in response_text:
                response_text = response_text.split("```json")[1].split("```")[0].strip()
            elif "```" in response_text:
                response_text = response_text.split("```")[1].split("```")[0].strip()

            try:
                plan_data = json.loads(response_text)
            except json.JSONDecodeError:
                plan_data = {"plan": [line.strip() for line in response_text.split("\n") if line.strip()]}

            if not isinstance(plan_data, dict):
                plan_data = {"plan": [str(plan_data)]}

            plan = plan_data.get("plan", [])
            reasoning = plan_data.get("reasoning", "Plan strategy created.")

            # Check for STOP condition
            if plan and any(isinstance(step, str) and step.startswith("STOP:") for step in plan):
                self.logger.info("plan-stopped-missing-info", reasoning=reasoning)
                return {
                    "plan": plan,
                    "current_step": plan[0],
                    "past_steps": [],
                }

            self.logger.info("plan-created", steps=len(plan), reasoning=reasoning)

        except Exception as e:
            self.logger.error("plan-parsing-error", error=str(e))
            plan = [
                "Step 1: Use google_places_tool to search for places in the requested area.",
                "Step 2: Use generate_plan_json_tool to create a structured itinerary.",
            ]
            reasoning = "Fallback plan due to parsing error."

        return {
            "plan": plan,
            "current_step": plan[0] if plan else None,
            "past_steps": [],
            "agent_type": "plan_and_execute",
        }

    async def _execute_node(self, state: PlanExecuteState) -> Dict[str, Any]:
        """Execute current step using LLM to decide which tools to call."""
        current_step = state.get("current_step")
        if not current_step:
            return {"current_step": None}

        self.logger.info("executing-step", step=current_step)
        
        # Check for STOP condition first
        if current_step.startswith("STOP:"):
            self.logger.info("execution-stopped", reason=current_step)
            clean_response = current_step.replace("STOP:", "").strip()
            
            # ✅ Synthesize response for missing info
            context = state.get("context", {})
            plan_params = context.get("plan_params", {})
            language = state.get("language", "es")
            
            # Build natural question for missing fields
            from src.agents.utils.structured_parameter_extractor import StructuredParameterExtractor
            extractor = StructuredParameterExtractor()
            missing = extractor.get_missing_required(plan_params)
            question = extractor.format_missing_fields_prompt(missing, language)
            
            result = {
                "step": current_step,
                "response": question,
                "tool_calls": 0,
                "is_stop": True,
            }

            return {
                "past_steps": state.get("past_steps", []) + [(current_step, result)],
                "current_step": None,
                "messages": state.get("messages", []) + [AIMessage(content=question)],
                "reasoning_steps": state.get("reasoning_steps", 0) + 1,
                "response_text": question,
            }

        # ✅ SIMPLIFIED: Use LLM with tools to execute the step
        context = state.get("context", {})
        plan_params = context.get("plan_params", {})
        
        # Build execution prompt
        exec_prompt = f"""Execute this step of the plan:

**Step:** {current_step}

**Available Context:**
- Plan Parameters: {json.dumps(plan_params, indent=2)}
- User Query: {state['input']}
- Language: {state.get('language', 'es')}

**Instructions:**
1. Call the necessary tools to complete this step
2. If the step mentions "geocode_city_tool", call it first with the city from plan_params
3. If the step mentions "google_places_tool", use it to search for places
4. If the step mentions "generate_plan_json_tool", call it with the found places
5. Return a summary of what was found/done

Execute the step now."""

        # Create executor with tools
        from langchain.agents import AgentExecutor, create_openai_tools_agent
        from langchain_core.prompts import ChatPromptTemplate, MessagesPlaceholder
        
        prompt_template = ChatPromptTemplate.from_messages([
            ("system", EXECUTOR_PROMPT),
            ("human", exec_prompt),
            MessagesPlaceholder(variable_name="agent_scratchpad"),
        ])
        
        agent = create_openai_tools_agent(
            llm=self.executor_llm,
            tools=self.all_tools,
            prompt=prompt_template,
        )
        
        agent_executor = AgentExecutor(
            agent=agent,
            tools=self.all_tools,
            verbose=False,
            max_iterations=5,
            handle_parsing_errors=True,
        )
        
        try:
            exec_result = await agent_executor.ainvoke({
                "input": exec_prompt,
            })
            
            response_text = exec_result.get("output", "Step completed")
            
            # Check if this was the final step (generate_plan_json_tool)
            if "generate_plan_json_tool" in current_step.lower():
                # Extract places and plan from intermediate steps
                places = []
                plan_json = None
                
                for step in exec_result.get("intermediate_steps", []):
                    action, observation = step
                    tool_name = action.tool if hasattr(action, 'tool') else str(action)
                    
                    if "google_places" in tool_name.lower() or "foursquare" in tool_name.lower():
                        # Extract places from observation
                        if isinstance(observation, list):
                            places.extend(observation)
                        elif isinstance(observation, dict) and "places" in observation:
                            places.extend(observation["places"])
                    
                    if "generate_plan_json" in tool_name.lower():
                        if isinstance(observation, dict):
                            plan_json = observation.get("plan")
                
                # Deduplicate places
                seen_ids = set()
                unique_places = []
                for place in places:
                    place_id = place.get("place_id") or place.get("id") or place.get("name")
                    if place_id and place_id not in seen_ids:
                        seen_ids.add(place_id)
                        unique_places.append(place)
                
                # ✅ Synthesize final response HERE (no separate synthesizer node)
                formatted_steps = self._format_past_steps(state.get("past_steps", []))
                
                synth_prompt = SYNTHESIZER_PROMPT.format(
                    query=state["input"],
                    language=state.get("language", "es"),
                    all_results=formatted_steps + f"\n\nFinal step: {response_text}",
                    context=json.dumps(context, indent=2),
                )
                
                synth_response = await self.synthesizer_llm.ainvoke([SystemMessage(content=synth_prompt)])
                final_response = clean_response_text(synth_response.content)
                
                # ✅ Save places to DB
                if unique_places:
                    try:
                        from src.tools.database.save_places import save_places_to_db
                        unique_places = await save_places_to_db(unique_places, self.settings)
                        self.logger.info("places-saved", count=len(unique_places))
                    except Exception as exc:
                        self.logger.error("failed-to-save-places", error=str(exc))

                past_steps = state.get("past_steps", []) + [(current_step, {
                    "step": current_step,
                    "response": response_text,
                    "tool_calls": len(exec_result.get("intermediate_steps", [])),
                })]

                return {
                    "past_steps": past_steps,
                    "current_step": None,  # Finish
                    "plan_json": plan_json,
                    "places": unique_places[:5],  # Top 5
                    "messages": state.get("messages", []) + [AIMessage(content=final_response)],
                    "reasoning_steps": state.get("reasoning_steps", 0) + 1,
                    "response_text": final_response,
                }
            
            # Not final step - continue with next
            past_steps = state.get("past_steps", []) + [(current_step, {
                "step": current_step,
                "response": response_text,
                "tool_calls": len(exec_result.get("intermediate_steps", [])),
            })]
            
            # Get next step from plan
            plan = state.get("plan", [])
            current_idx = next((i for i, step in enumerate(plan) if step == current_step), -1)
            next_step = plan[current_idx + 1] if current_idx >= 0 and current_idx + 1 < len(plan) else None
            
            return {
                "past_steps": past_steps,
                "current_step": next_step,
                "messages": state.get("messages", []) + [AIMessage(content=response_text)],
                "reasoning_steps": state.get("reasoning_steps", 0) + 1,
            }
            
        except Exception as e:
            self.logger.error("execution-failed", error=str(e))
            
            return {
                "past_steps": state.get("past_steps", []) + [(current_step, {
                    "step": current_step,
                    "response": f"Error: {str(e)}",
                    "tool_calls": 0,
                })],
                "current_step": None,
                "messages": state.get("messages", []) + [AIMessage(content=f"Error executing step: {str(e)}")],
                "reasoning_steps": state.get("reasoning_steps", 0) + 1,
                "response_text": f"Lo siento, hubo un error al ejecutar este paso: {str(e)}",
            }

    async def _replan_node(self, state: PlanExecuteState) -> Dict[str, Any]:
        """Adapt plan based on execution results."""
        self.logger.info("replanning")

        original_plan = state.get("plan", [])
        past_steps = state.get("past_steps", [])
        formatted_steps = self._format_past_steps(past_steps)

        prompt = REPLANNER_PROMPT.format(
            original_plan=json.dumps(original_plan),
            past_steps=formatted_steps,
            situation="Execution in progress",
        )

        messages = [SystemMessage(content=prompt)]

        try:
            response = await self.planner_llm.ainvoke(messages)
            replan_data = json.loads(response.content)
            decision = replan_data.get("decision", "continue")

            if decision == "continue":
                plan = state.get("plan", [])
                next_step = plan[len(past_steps)] if len(past_steps) < len(plan) else None
                return {"current_step": next_step}

            elif decision == "replan":
                new_plan = replan_data.get("updated_plan", [])
                return {"plan": new_plan, "current_step": new_plan[0] if new_plan else None}

            else:  # finish
                return {"current_step": None}

        except Exception as e:
            self.logger.error(f"Replan failed: {e}")
            return {"current_step": None}

    def _should_continue_or_replan(self, state: PlanExecuteState) -> str:
        """Decide whether to continue, replan, or finish."""
        current_step = state.get("current_step")

        if current_step is None:
            return "end"

        if current_step.startswith("STOP:"):
            return "end"

        return "continue"

    def _format_past_steps(self, past_steps: List[tuple]) -> str:
        """Format past steps for display in prompts."""
        if not past_steps:
            return "None yet."

        lines = []
        for idx, (step, result) in enumerate(past_steps, 1):
            lines.append(f"{idx}. {step}")
            response = result.get("response", "")
            if response:
                lines.append(f"   Result: {response[:200]}")

            tool_calls = result.get("tool_calls", 0)
            if tool_calls:
                lines.append(f"   Tools used: {tool_calls}")

        return "\n".join(lines)

    async def run(
        self,
        query: str,
        language: str = "es",
        context: Dict[str, Any] | None = None,
    ) -> Dict[str, Any]:
        """
        Execute the Plan-and-Execute agent.
                    return t
            return None

        def _extract_lat_lon_from_text(text: str) -> Optional[Dict[str, float]]:
            if not text:
                return None
            m = re.search(r"lat\s*=\s*([\-0-9\.]+)\s*,\s*lon\s*=\s*([\-0-9\.]+)", text)
            if not m:
                return None
            try:
                return {"latitude": float(m.group(1)), "longitude": float(m.group(2))}
            except Exception:
                return None

        def _ensure_location_in_context(ctx: Dict[str, Any], lat: float, lon: float, city: Optional[str] = None) -> Dict[str, Any]:
            updated = dict(ctx or {})
            loc = dict(updated.get("location") or {})
            loc["latitude"] = lat
            loc["longitude"] = lon
            if city and not loc.get("city"):
                loc["city"] = city
            updated["location"] = loc
            return updated

        def _pick_top_places(places: List[Dict[str, Any]], n: int = 3) -> List[Dict[str, Any]]:
            def key(p: Dict[str, Any]):
                rating = p.get("rating") or 0
                reviews = p.get("user_ratings_total") or 0
                return (rating, reviews)

            return sorted(places or [], key=key, reverse=True)[:n]

        def _place_to_stop(
            place: Dict[str, Any],
            stop_number: int,
            category: str,
            vibes: List[str],
            start_time: Optional[str] = None,
        ) -> Dict[str, Any]:
            """Convert Google Places result to plan stop."""
            geometry = place.get("geometry", {})
            location = geometry.get("location", {})
            lat = location.get("lat") or place.get("latitude")
            lon = location.get("lng") or location.get("lon") or place.get("longitude")

            photos = place.get("photos", [])
            images = []
            if photos:
                for photo in photos[:3]:
                    photo_ref = photo.get("photo_reference") or photo.get("name", "").split("/")[-1]
                    if photo_ref:
                        images.append({
                            "photo_reference": photo_ref,
                            "width": photo.get("width", 400),
                            "height": photo.get("height", 400),
                        })

            duration = 90 if category == "restaurant" else 60
            recommended_start = start_time or "TBD"
            estimated_end = "TBD"

            if start_time and start_time != "TBD":
                try:
                    hour, minute = map(int, start_time.split(":"))
                    total_minutes = hour * 60 + minute + duration
                    end_hour = (total_minutes // 60) % 24
                    end_minute = total_minutes % 60
                    estimated_end = f"{end_hour:02d}:{end_minute:02d}"
                except Exception:
                    estimated_end = "TBD"

            return {
                "stopNumber": stop_number,
                "localId": str(place.get("id") or place.get("place_id") or place.get("name") or f"stop-{stop_number}"),
                "name": place.get("name") or place.get("displayName", {}).get("text") or "Unknown",
                "category": category,
                "typeLabel": place.get("primary_type") or place.get("primaryType") or (place.get("types") or [None])[0],
                "timing": {
                    "recommendedStart": recommended_start,
                    "suggestedDurationMinutes": duration,
                    "estimatedEnd": estimated_end,
                },
                "location": {
                    "address": place.get("formatted_address") or place.get("formattedAddress") or place.get("address"),
                    "lat": lat,
                    "lng": lon,
                    "zone": place.get("neighborhood") or place.get("vicinity"),
                    "travelTimeFromPreviousMinutes": None,
                },
                "details": {
                    "vibes": vibes,
                    "targetAudience": ["couple"],
                    "music": None,
                    "noiseLevel": None,
                    "averageSpendPerPerson": None,
                    "rating": place.get("rating"),
                    "userRatingsTotal": place.get("user_ratings_total") or place.get("userRatingCount"),
                },
                "selectionReasons": [
                    f"Rating: {place.get('rating', 'N/A')} ({place.get('user_ratings_total') or place.get('userRatingCount', 0)} reviews)",
                    "Matches your request",
                ],
                "actions": {
                    "canReserve": False,
                    "reservationUrl": place.get("website") or place.get("websiteUri"),
                    "googleMapsUrl": place.get("google_maps_uri") or place.get("googleMapsUri") or place.get("url"),
                    "phone": place.get("international_phone_number") or place.get("nationalPhoneNumber") or place.get("phone"),
                },
                "alternatives": None,
                "personalTips": None,
                "images": images if images else None,
            }

        # Check for STOP condition
        if current_step.startswith("STOP:"):
            self.logger.info("execution-stopped", reason=current_step)
            clean_response = current_step.replace("STOP:", "").strip()
            
            # ✅ Synthesize response for missing info
            context = state.get("context", {})
            plan_params = context.get("plan_params", {})
            language = state.get("language", "es")
            
            # Build natural question for missing fields
            from src.agents.utils.structured_parameter_extractor import StructuredParameterExtractor
            extractor = StructuredParameterExtractor()
            missing = extractor.get_missing_required(plan_params)
            question = extractor.format_missing_fields_prompt(missing, language)
            
            result = {
                "step": current_step,
                "response": question,
                "tool_calls": 0,
                "is_stop": True,
            }

            return {
                "past_steps": state.get("past_steps", []) + [(current_step, result)],
                "current_step": None,  # Force finish
                "messages": state.get("messages", []) + [AIMessage(content=question)],
                "reasoning_steps": state.get("reasoning_steps", 0) + 1,
                "response_text": question,  # ✅ Set final response
            }

        # Prepare context and extraction variables
        ctx = dict(state.get("context") or {})
        plan_params = ctx.get("plan_params", {})
        
        # Get city from plan_params (no need for LLM extraction)
        cities = plan_params.get("cities", [])
        city_guess = cities[0] if cities else None

        if "google_places_tool" in current_step:
            # Ensure we have coordinates
            loc = ctx.get("location") or {}
            lat = loc.get("latitude")
            lon = loc.get("longitude")

            if lat is None or lon is None:
                geocode_tool = _get_tool("geocode_city_tool")
                if geocode_tool and city_guess:
                    try:
                        geo_text = await geocode_tool.ainvoke({"city": city_guess})
                        coords = _extract_lat_lon_from_text(geo_text if isinstance(geo_text, str) else str(geo_text))
                        if coords:
                            lat = coords["latitude"]
                            lon = coords["longitude"]
                            ctx = _ensure_location_in_context(ctx, lat, lon, city_guess)
                    except Exception as e:
                        self.logger.warning(f"Geocode failed: {e}")

            # Call google places
            gp_tool = _get_tool("google_places_tool")
            if gp_tool:
                user_query = state["query"]
                conversation_history = ctx.get("conversation_history_text", "") or ctx.get("conversation_history", "")
                combined_context = (user_query + " " + conversation_history).lower()

                intent_keywords = []
                if any(word in combined_context for word in ["festiv", "animad", "fiesta", "party"]):
                    intent_keywords.append("bares animados")
                if any(word in combined_context for word in ["romántic", "pareja", "romantic"]):
                    intent_keywords.append("restaurantes románticos")
                if any(word in combined_context for word in ["cultural", "museo", "histor"]):
                    intent_keywords.append("museos y atracciones culturales")
                if any(word in combined_context for word in ["restaurante", "comer", "gastronom"]):
                    intent_keywords.append("restaurantes populares")
                if any(word in combined_context for word in ["bar", "copa", "bebida"]):
                    intent_keywords.append("bares con ambiente")
                if any(word in combined_context for word in ["tranquil", "relaj"]):
                    intent_keywords.append("cafeterías")

                if not intent_keywords:
                    intent_keywords = ["lugares de interés turístico"]

                if city_guess:
                    gp_query = f"{' y '.join(intent_keywords[:2])} en {city_guess}"
                else:
                    gp_query = user_query

                self.logger.info("google-places-query-built", query=gp_query, city=city_guess)

                try:
                    gp_result = await gp_tool.ainvoke({
                        "query": gp_query,
                        "latitude": lat,
                        "longitude": lon,
                        "radius_meters": 3000,
                        "max_results": 10,
                        "language": state.get("language", "es"),
                    })

                    tool_msg = FunctionMessage(name="google_places_tool", content=json.dumps(gp_result))
                    prior_messages = list(state.get("messages", []))
                    aggregated_messages = prior_messages + [tool_msg]

                    past_steps = state.get("past_steps", [])
                    past_steps.append((current_step, {
                        "step": current_step,
                        "response": "google_places_tool executed",
                        "tool_calls": 1,
                        "tool_results": [tool_msg],
                    }))

                    plan = state.get("plan", [])
                    completed_count = len(past_steps)
                    next_step = plan[completed_count] if completed_count < len(plan) else None

                    self.logger.info("step-executed", completed=completed_count, total=len(plan))

                    return {
                        "context": ctx,
                        "past_steps": past_steps,
                        "current_step": next_step,
                        "messages": aggregated_messages,
                        "reasoning_steps": state.get("reasoning_steps", 0) + 1,
                    }
                except Exception as e:
                    self.logger.error(f"google_places_tool execution failed: {e}")

        # If step requires generate_plan_json_tool
        if "generate_plan_json_tool" in current_step:
            excluded_types = {
                "locality", "political", "administrative_area_level_1",
                "administrative_area_level_2", "country", "sublocality",
                "neighborhood", "postal_code", "route", "street_address",
            }

            def is_valid_place(place: Dict[str, Any]) -> bool:
                """Check if a place is visitable, not a city/area."""
                primary_type = (place.get("primary_type") or "").lower()
                types = [t.lower() for t in (place.get("types") or [])]
                all_types = set([primary_type] + types)

                if all_types & excluded_types:
                    return False

                name = (place.get("name") or "").lower()
                if name in {"zaragoza", "madrid", "barcelona", "valencia", "sevilla", "málaga", "bilbao", "murcia", "alicante", "granada"}:
                    return False

                return True

            # Collect places from messages with deduplication
            all_msgs = list(state.get("messages", []))
            all_places = []
            seen_ids = set()

            for msg in all_msgs:
                if isinstance(msg, FunctionMessage) and getattr(msg, "name", "") == "google_places_tool":
                    try:
                        payload = json.loads(msg.content) if isinstance(msg.content, str) else msg.content
                        places = payload.get("places", []) if isinstance(payload, dict) else []

                        valid_places = [p for p in places if is_valid_place(p)]
                        self.logger.info("places-filtered", original_count=len(places), valid_count=len(valid_places))

                        for place in valid_places:
                            place_id = place.get("place_id") or place.get("id") or place.get("name")
                            if place_id and place_id not in seen_ids:
                                seen_ids.add(place_id)
                                all_places.append(place)

                    except Exception:
                        continue

            # Get top places
            top = _pick_top_places(all_places, n=5)

            if not top:
                clean_response = "No tengo suficientes datos (lugares) para construir un plan. ¿Puedes confirmar la zona exacta?"
                past_steps = state.get("past_steps", [])
                past_steps.append((current_step, {"step": current_step, "response": clean_response, "tool_calls": 0}))

                return {
                    "past_steps": past_steps,
                    "current_step": None,
                    "messages": state.get("messages", []) + [AIMessage(content=clean_response)],
                    "reasoning_steps": state.get("reasoning_steps", 0) + 1,
                    "response_text": clean_response,  # ✅ Set final response
                }

            # ✅ Get vibes from plan_params (no need for LLM extraction)
            vibes = plan_params.get("vibes", ["casual"])
            if not isinstance(vibes, list):
                vibes = [vibes]

            # Get city
            city_final = (
                (ctx.get("location") or {}).get("city") or
                city_guess or
                "Ciudad"
            )

            # ✅ NEW: Generate title WITHOUT duplicates
            type_text = "plan"
            if any("museum" in (p.get("primary_type") or "").lower() for p in top):
                type_text = "recorrido cultural"
            elif any("night_club" in (p.get("primary_type") or "").lower() or "disco" in (p.get("primary_type") or "").lower() for p in top):
                type_text = "noche de fiesta"
            elif any("bar" in (p.get("primary_type") or "").lower() for p in top):
                type_text = "ruta de bares"
            elif any("restaurant" in (p.get("primary_type") or "").lower() for p in top):
                type_text = "ruta gastronómica"

            # Select vibe text, avoiding duplication with type_text
            vibe_text = ""
            if "romantic" in vibes and "romántico" not in type_text:
                vibe_text = "romántico"
            elif "fun" in vibes or "party" in vibes:
                if "festiv" not in type_text and "fiesta" not in type_text:
                    vibe_text = "festivo"
            elif "chill" in vibes:
                vibe_text = "relajado"
            elif "cultural" in vibes and "cultural" not in type_text:
                vibe_text = "cultural"
            else:
                vibe_text = "perfecto"

            # Build title without duplication
            if vibe_text:
                title = f"Tu {type_text} {vibe_text} en {city_final.title()}"
            else:
                title = f"Tu {type_text} en {city_final.title()}"

            # Build stops with proper timing
            stops = []
            start_hour = 20  # Default evening start
            current_hour = start_hour

            for idx, place in enumerate(top, 1):
                current_time = f"{current_hour:02d}:00"
                stop = _place_to_stop(place, idx, "venue", vibes, current_time)
                stops.append(stop)
                current_hour += 2  # Advance 2 hours per stop

            # Call generate_plan_json_tool
            gen_tool = _get_tool("generate_plan_json_tool")
            if gen_tool:
                try:
                    # Get budget from plan_params
                    budget = plan_params.get("budget_per_person")
                    num_people = plan_params.get("num_people", 2)

                    plan_json_result = await gen_tool.ainvoke({
                        "title": title,
                        "description": f"Un plan a medida en {city_final}",
                        "category": "custom",
                        "vibes": vibes,
                        "date": "TBD",
                        "start_time": f"{start_hour:02d}:00",
                        "city": city_final.title(),
                        "group_size": num_people,
                        "stops": stops,
                        "total_duration_hours": len(stops) * 2,
                        "total_distance_km": 5.0,
                        "budget_per_person": budget,
                        "user_max_budget_per_person": budget,
                        "final_recommendations": [
                            "Confirma horarios de apertura antes de ir",
                            "Considera reservar con anticipación",
                        ],
                    })

                    if plan_json_result.get("success"):
                        plan_json = plan_json_result.get("plan")
                    else:
                        plan_json = None

                    past_steps = state.get("past_steps", [])
                    past_steps.append((current_step, {
                        "step": current_step,
                        "response": "Plan JSON generated",
                        "tool_calls": 1,
                    }))
                    
                    # ✅ Synthesize final response HERE (no separate synthesizer node)
                    formatted_steps = self._format_past_steps(past_steps)
                    
                    synth_prompt = SYNTHESIZER_PROMPT.format(
                        query=state["input"],
                        language=state.get("language", "es"),
                        all_results=formatted_steps,
                        context=json.dumps(state.get("context", {}), indent=2),
                    )
                    
                    synth_response = await self.synthesizer_llm.ainvoke([SystemMessage(content=synth_prompt)])
                    response_text = clean_response_text(synth_response.content)
                    
                    # ✅ Save places to DB
                    if top:
                        try:
                            top = await save_places_to_db(top, self.settings)
                            self.logger.info("places-saved", count=len(top))
                        except Exception as exc:
                            self.logger.error("failed-to-save-places", error=str(exc))

                    return {
                        "past_steps": past_steps,
                        "current_step": None,
                        "plan_json": plan_json,
                        "places": top,
                        "messages": state.get("messages", []) + [AIMessage(content=response_text)],
                        "reasoning_steps": state.get("reasoning_steps", 0) + 1,
                        "response_text": response_text,  # ✅ Set final response
                    }

                except Exception as e:
                    self.logger.error(f"generate_plan_json_tool failed: {e}")

        # Default fallback
        past_steps = state.get("past_steps", [])
        past_steps.append((current_step, {"step": current_step, "response": "Step executed", "tool_calls": 0}))

        return {
            "past_steps": past_steps,
            "current_step": None,
            "messages": state.get("messages", []) + [AIMessage(content="Step completed")],
            "reasoning_steps": state.get("reasoning_steps", 0) + 1,
        }

    async def _replan_node(self, state: PlanExecuteState) -> Dict[str, Any]:
        """Adapt plan based on execution results."""
        self.logger.info("replanning")

        original_plan = state.get("plan", [])
        past_steps = state.get("past_steps", [])
        formatted_steps = self._format_past_steps(past_steps)

        prompt = REPLANNER_PROMPT.format(
            original_plan=json.dumps(original_plan),
            past_steps=formatted_steps,
            situation="Execution in progress",
        )

        messages = [SystemMessage(content=prompt)]

        try:
            response = await self.planner_llm.ainvoke(messages)
            replan_data = json.loads(response.content)
            decision = replan_data.get("decision", "continue")

            if decision == "continue":
                plan = state.get("plan", [])
                next_step = plan[len(past_steps)] if len(past_steps) < len(plan) else None
                return {"current_step": next_step}

            elif decision == "replan":
                new_plan = replan_data.get("updated_plan", [])
                return {"plan": new_plan, "current_step": new_plan[0] if new_plan else None}

            else:  # finish
                return {"current_step": None}

        except Exception as e:
            self.logger.error(f"Replan failed: {e}")
            return {"current_step": None}

    def _should_continue_or_replan(self, state: PlanExecuteState) -> str:
        """Decide whether to continue, replan, or finish."""
        current_step = state.get("current_step")

        if current_step is None:
            return "end"

        if current_step.startswith("STOP:"):
            return "end"

        return "continue"

    def _format_past_steps(self, past_steps: List[tuple]) -> str:
        """Format past steps for display in prompts."""
        if not past_steps:
            return "None yet."

        lines = []
        for idx, (step, result) in enumerate(past_steps, 1):
            lines.append(f"{idx}. {step}")
            response = result.get("response", "")
            if response:
                lines.append(f"   Result: {response[:200]}")

            tool_calls = result.get("tool_calls", 0)
            if tool_calls:
                lines.append(f"   Tools used: {tool_calls}")

        return "\n".join(lines)

    async def run(
        self,
        query: str,
        language: str = "es",
        context: Dict[str, Any] | None = None,
    ) -> Dict[str, Any]:
        """
        Execute the Plan-and-Execute agent.

        Args:
            query: User query
            language: Response language
            context: Additional context

        Returns:
            Dict with response_text, places, and metadata
        """
        context = context or {}
        self.logger.info("plan-and-execute-starting", query=query, language=language)
        
        # ✅ Ensure graph is initialized (async)
        await self._ensure_graph_initialized()

        # Prepare serializable context
        serializable_context = {k: v for k, v in context.items() if k != "history_messages"}

        if "history_messages" in context and context["history_messages"]:
            history_summary = []
            for msg in context["history_messages"]:
                role = msg.__class__.__name__.replace("Message", "")
                content = msg.content if hasattr(msg, "content") else str(msg)
                history_summary.append(f"{role}: {content}")
            serializable_context["conversation_history_text"] = "\n".join(history_summary)

        # Initial state
        initial_state = {
            "input": query,  # ✅ NEW: Use "input" instead of "query"
            "language": language,
            "context": serializable_context,
            "plan": [],
            "past_steps": [],
            "current_step": None,
            "messages": [],
            "response_text": "",
            "places": [],
            "plan_json": None,
            "agent_type": "plan_and_execute",
            "model_used": "",
            "reasoning_steps": 0,
        }

        # Run the graph
        config = {"configurable": {"thread_id": str(uuid4())}}

        try:
            final_state = await self.graph.ainvoke(initial_state, config)
            self.logger.info(
                "plan-and-execute-completed",
                reasoning_steps=final_state.get("reasoning_steps", 0),
                places_found=len(final_state.get("places", [])),
            )

            return {
                "response_text": final_state.get("response_text", ""),
                "places": final_state.get("places", []),
                "plan": final_state.get("plan_json"),
                "tool_calls": final_state.get("reasoning_steps", 0),
                "reasoning_steps": final_state.get("reasoning_steps", 0),
                "agent_type": "plan_and_execute",
                "model_used": final_state.get("model_used", "gpt-4o + gpt-4o-mini"),
                "plan_params": serializable_context.get("plan_params"),  # ✅ Return from context
            }

        except Exception as exc:
            self.logger.error("plan-and-execute-failed", error=str(exc), query=query)
            raise
